{
  "name": "lectureforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "infra:up": "docker compose up -d && npm run storage:init",
    "storage:init": "tsx scripts/storage-init.ts",
    "search:reindex": "tsx scripts/reindex-all.ts",
    "models:init": "tsx scripts/models-init.ts",
    "sources:retry": "tsx scripts/retry-sources.ts",
    "infra:down": "docker compose down",
    "control": "node control/server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@auth/prisma-adapter": "2.11.1",
    "@aws-sdk/client-s3": "3.913.0",
    "@aws-sdk/s3-request-presigner": "3.913.0",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.90.5",
    "bcryptjs": "3.0.2",
    "bullmq": "5.61.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.2.3",
    "ioredis": "5.8.2",
    "katex": "^0.16.25",
    "lucide-react": "0.546.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.29",
    "pdfjs-dist": "^4.10.38",
    "pino": "9.14.0",
    "radix-ui": "1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-dropzone": "14.3.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "3.3.1",
    "undici": "^7.16.0",
    "unpdf": "1.3.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.16",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "pdf-lib": "^1.17.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.16",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
