# ───────── App ─────────
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Site-wide password asked before anything else (pages and API). Empty = no gate.
LECTURE_ACCESS_KEY=
# Who may create an account (comma-separated emails or @domain). Empty = anyone.
SIGNUP_ALLOWED_EMAILS=

# Optional OAuth sign-in (each provider is enabled only when its id is set)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ───────── Data stores (docker compose provides these locally) ─────────
DATABASE_URL=postgresql://lectureforge:lectureforge@localhost:5432/lectureforge
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (SeaweedFS locally via docker compose; S3 / R2 / B2 in production)
S3_ENDPOINT=http://localhost:9000
# Endpoint the browser uses for presigned uploads, if different from S3_ENDPOINT
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lectureforge
S3_ACCESS_KEY_ID=lectureforge
S3_SECRET_ACCESS_KEY=lectureforge-secret
S3_FORCE_PATH_STYLE=true

# ───────── AI generation ─────────
# Set ANTHROPIC_API_KEY to enable study-guide generation (Claude via the official SDK).
# Only this explicit key is used; ambient ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL are ignored.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Claude model (Sonnet 5.5 / Opus 5.5) and effort (medium / high) are chosen on the admin page (/admin).
# On a safety-classifier decline, retry on a fallback model chosen by the API
AI_REFUSAL_FALLBACK=true
# AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Local or OpenAI models instead (quality varies; citations are still verified):
# AI_PROVIDER=openai-compatible
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=qwen2.5:14b
GENERATION_CONCURRENCY=3

# ───────── Speech-to-text ─────────
# Local Whisper (docker compose service "stt", OpenAI-compatible). For hosted OpenAI use
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1 with a key, model whisper-1 and TRANSCRIPTION_MAX_MB=24.
TRANSCRIPTION_PROVIDER=openai-compatible
TRANSCRIPTION_BASE_URL=http://localhost:8000/v1
TRANSCRIPTION_API_KEY=
# large-v3-turbo: near large-v3 accuracy, several times faster (multilingual)
TRANSCRIPTION_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Local Whisper takes whole lectures; split only above this size
TRANSCRIPTION_MAX_MB=500
# Long recordings are cut at pauses into parts of about this length (resumable, steady progress)
TRANSCRIPTION_CHUNK_SECONDS=300
TRANSCRIPTION_PART_TIMEOUT_SECONDS=1800
# One transcription at a time per GPU is fastest
TRANSCRIPTION_CONCURRENCY=1
# Managed alternative with speaker diarization:
# TRANSCRIPTION_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# ───────── Embeddings (pgvector column is vector(768)) ─────────
# EmbeddingGemma on local Ollama (ollama pull embeddinggemma). EMBEDDING_PROVIDER=none = keyword search only.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_QUERY_PREFIX="task: search result | query: "
EMBEDDING_DOCUMENT_PREFIX="title: none | text: "

# ───────── Local models (Ollama) ─────────
OLLAMA_BASE_URL=http://localhost:11434
# Tutor chatbot (ollama pull gemma4)
TUTOR_MODEL=gemma4:latest
# Let Gemma reason before answering: better hints, slower replies
TUTOR_THINK=false
TUTOR_NUM_CTX=16384
# Vision model for OCR of handwriting and photos
OCR_VISION_MODEL=gemma4:latest

# ───────── OCR / media tooling (worker only) ─────────
# OCR: tesseract | ollama-vision | hybrid (Tesseract with line boxes, Gemma vision when unsure) | none
# Scanned PDFs also need poppler's pdftoppm.
OCR_PROVIDER=hybrid
# Tesseract confidence (0-100) below which hybrid mode asks the vision model
OCR_MIN_CONFIDENCE=70
TESSERACT_PATH=tesseract
PDFTOPPM_PATH=pdftoppm
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# LibreOffice, converts Word (.docx/.doc/.odt/.rtf) and slides (.pptx/.ppt/.odp) to PDF.
# On Windows point at the console binary, e.g. C:Program FilesLibreOfficeprogramsoffice.com
# (soffice.exe detaches from the console and never reports completion).
SOFFICE_PATH=soffice
# WORKER_TMP_DIR=/var/tmp/lectureforge
INGEST_CONCURRENCY=2

# ───────── Malware scanning ─────────
# "clamav" enables scanning (docker compose --profile scan up -d)
MALWARE_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ───────── YouTube import ─────────
# Off by default. Enabling it means your deployment downloads audio with yt-dlp;
# you are responsible for complying with YouTube's Terms of Service.
ENABLE_YOUTUBE_INGEST=false
YTDLP_PATH=yt-dlp

# ───────── Seed (npm run db:seed) ─────────
# Password for the demo account demo@lectureforge.test (local development only)
SEED_DEMO_PASSWORD=change-me-demo-password

# Admin page / control service (npm run control): http://localhost:3200/admin,
# also reachable as /admin through the app. Password: LECTURE_ACCESS_KEY.
CONTROL_URL=http://127.0.0.1:3200
CONTROL_COMPOSE_PROJECT=curiosity
CONTROL_LOCAL_PROCESSES=web,worker
CONTROL_OLLAMA_UNLOAD=http://localhost:11434
CONTROL_APP_URL=http://localhost:3000
# Where the admin page reaches the app to create and list accounts.
CONTROL_APP_INTERNAL_URL=http://127.0.0.1:3000
